# Local SQLite database — created automatically on first run.
DATABASE_URL="file:./frontage-growth.db"

# Master key for encrypting stored provider API keys (AES-256-GCM).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FRONTAGE_GROWTH_MASTER_KEY=""

# Local Ollama.
OLLAMA_HOST="http://localhost:11434"

# Google OAuth (Search Console / Analytics) — Google Cloud Console → APIs &
# Services → Google Auth Platform → Clients → create a Web application
# client with this exact redirect URI registered.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3920/api/auth/google/callback"

# Optional env-var fallback layer beneath the DB-stored key pools in
# Settings → AI Models (prefer adding keys from the UI instead).
GEMINI_API_KEY=""
GEMINI_API_KEY_BACKUP=""
GEMINI_API_KEYS=""

OPENROUTER_API_KEY=""
OPENROUTER_API_KEY_BACKUP=""
OPENROUTER_API_KEYS=""

SERPAPI_API_KEY=""
SERPAPI_API_KEY_BACKUP=""
SERPAPI_API_KEYS=""
